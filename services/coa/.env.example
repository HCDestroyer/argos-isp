# coa-dispatcher. En docker compose estas variables vienen de infra/.env.
PORT=3200
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Redis: bus de eventos (contrato en .claude/integration/contratos/eventos.md)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# Stream y grupo de consumidores. No cambiarlos fuera de pruebas (las pruebas usan un stream con prefijo propio).
COA_STREAM=argos:eventos
COA_GRUPO=coa
# Nombre del consumidor dentro del grupo (por defecto coa-<pid>; fíjalo por nodo si corren varios)
COA_CONSUMIDOR=
# Si el grupo no existe se crea leyendo desde: $ (solo eventos nuevos) o 0 (todo el stream)
COA_GRUPO_INICIO=$
# Entradas sin confirmar que se reclaman (XAUTOCLAIM) tras estos ms
COA_RECLAMAR_TRAS_MS=60000

# Postgres: lee core.servicios, network.planes(_routers), network.sesiones y network.routers;
# escribe audit.red y audit.outbox (coa.fallido).
DB_HOST=localhost
DB_PORT=5432
DB_USER=argosisp
DB_PASSWORD=
DB_DATABASE=argosisp

# Clave para descifrar network.routers.radius_secret (la misma AAA_PPP_KEY de apps/api y aaa). Nunca la commitees.
AAA_PPP_KEY=

# Puerto de /radius incoming en el MikroTik
COA_NAS_PORT=3799
# Espera por respuesta de cada envío (ms)
COA_TIMEOUT_MS=2000
# Reintentos tras el primer envío ante timeout o error de red (un NAK no se reintenta)
COA_REINTENTOS=3
# Espera base del backoff exponencial entre reintentos (ms): 500, 1000, 2000
COA_ESPERA_MS=500
# IP local de origen (debe ser la que el router tiene en /radius); vacío = la que elija el sistema
COA_ORIGEN_IP=

# Perfil de suspendido por CoA (verificado en RouterOS 7.24.5; igual que AAA_SUSPENDIDO_* de aaa)
COA_SUSPENDIDO_RATE_LIMIT=256k/256k
COA_SUSPENDIDO_ADDRESS_LIST=suspendidos
COA_SUSPENDIDO_FILTER_ID=argos-corte.in
# Suspender una sesión con IPv6 (/64 o /56 en network.sesiones): coa (CoA sin reconectar; IPv6 bloqueado
# con reset) o disconnect (reconecta con el perfil suspendido y el router puede redirigir IPv6 a /corte).
# Las sesiones solo IPv4 van siempre por CoA. Ver infra/mikrotik/README.md, "Corte IPv6 hacia /corte".
COA_SUSPENDER_CON_IPV6=coa

# Prefijo de aaa:user:<user_ppp> en Redis (mismo que aaa y la API): de ahí salen las cadenas completas de
# Mikrotik-Rate-Limit del plan (plan.rate_limit / rate_limit_limitado) para los CoA de velocidad.
AAA_REDIS_PREFIJO=aaa:user:

# GET /metrics (Prometheus). Vacío: abierto (solo en la red interna). Con valor: Authorization: Bearer <token>
METRICS_TOKEN=
