# Servicio aaa (endpoints REST para FreeRADIUS). En docker compose estas variables vienen de infra/.env.
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Redis: aaa lee aaa:user:<user_ppp> (lo mantiene A1, sin TTL) y cachea ahí lo que obtiene del respaldo.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# Prefijo de la clave (no cambiarlo fuera de pruebas: es el contrato con A1)
AAA_REDIS_PREFIJO=aaa:user:

# Respaldo cuando Redis no tiene la clave o no responde:
#   api       GET ${API_INTERNAL_URL}internal/aaa/servicio?user_ppp=  (Bearer $AAA_INTERNAL_TOKEN)
#   fixtures  services/aaa/fixtures/servicios.json (solo pruebas y desarrollo sin la API)
AAA_RESPALDO=api
API_INTERNAL_URL=http://localhost:3333/api/v1/
AAA_INTERNAL_TOKEN=
# Tiempo máximo de la consulta a la API, incluida la espera de socket (rlm_rest espera 0.8 s en total;
# Redis se corta a los 150 ms). Con 300 ms, una reconexión masiva con Redis vacío terminaba en Reject.
AAA_API_TIMEOUT_MS=600
# Conexiones keep-alive simultáneas a la API (las demás consultas esperan socket dentro del timeout)
AAA_API_CONEXIONES=16
# 1 (por defecto): las consultas que llegan a la vez van juntas en POST internal/aaa/servicios (hasta 100).
# 0: una GET por usuario, como antes. Si la API no tiene la ruta de lotes, aaa vuelve solo al GET.
AAA_API_LOTES=1
# Ruta alternativa de fixtures (por defecto services/aaa/fixtures/servicios.json)
# AAA_FIXTURES_RUTA=

# Clave para descifrar pass_ppp y radius_secret: 32 bytes en base64, la misma que usa apps/api para cifrar.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Nunca la commitees.
AAA_PPP_KEY=

# Perfil de suspendido (verificado en RouterOS 7.24.5, ver infra/mikrotik/README.md)
AAA_SUSPENDIDO_RATE_LIMIT=256k/256k
AAA_SUSPENDIDO_GRUPO=suspendido
AAA_SUSPENDIDO_ADDRESS_LIST=suspendidos
AAA_SUSPENDIDO_FILTER_ID=argos-corte.in

# Modo degradado: si Redis y la API no responden a la vez, aaa autoriza con el último perfil conocido
# del usuario (mismo estado y atributos que la última vez que lo vio). Ver README, "Modo degradado".
#   aceptar   (por defecto) usa el último perfil conocido; sin él → Reject
#   rechazar  Reject siempre (comportamiento anterior a la semana 3)
AAA_DEGRADADO=aceptar
# Archivo del último perfil conocido (pass_ppp cifrada, 0600). Vacío: solo en memoria (se pierde al
# reiniciar). La imagen Docker usa /var/lib/argosisp-aaa/ultimo-conocido.json.
AAA_DEGRADADO_RUTA=
# Cada cuántos segundos se copia aaa:user:* de Redis al último perfil conocido (0 = solo lo que se
# autoriza en este nodo)
AAA_DEGRADADO_ESPEJO_S=300
# Máximo de usuarios guardados (sale el que lleva más tiempo sin verse)
AAA_DEGRADADO_MAX=200000

# Acct-Interim-Interval que se devuelve en cada Access-Accept (segundos)
AAA_INTERIM_SEGUNDOS=300

# Accounting: /aaa/accounting encola en BullMQ (cola aaa-accounting) en el mismo Redis (REDIS_HOST/PORT/DB).
# Debe ser el mismo prefijo que usa el worker de apps/api (`node ace sesiones:worker`).
COLAS_PREFIJO=argosisp

# GET /metrics (Prometheus). Vacío: abierto (solo en la red interna). Con valor: Authorization: Bearer <token>
METRICS_TOKEN=

# Clientes de FreeRADIUS por evento (router.conexion_registrada / _rotada / _eliminada, túnel WireGuard).
# 1 = regenera clients.d (AAA_CLIENTS_DIR) desde network.routers (DB_*) y avisa a FreeRADIUS por el FIFO
# clients.d/.recargar (su contenedor corre freeradius/recargar.sh). Vacío: a mano con `argosisp radius-clientes`.
AAA_CLIENTES_EVENTOS=
# Grupo del stream argos:eventos, uno por nodo aaa (por defecto radius-clientes:<AAA_NODO o hostname>)
AAA_NODO=
AAA_CLIENTES_GRUPO=
AAA_CLIENTES_STREAM=argos:eventos
