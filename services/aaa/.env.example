# Servicio aaa (endpoints REST para FreeRADIUS). En docker compose estas variables vienen de infra/.env.
PORT=3100
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# A2 las usará al implementar authorize/accounting (nombres reservados, sin valores reales):
REDIS_HOST=localhost
REDIS_PORT=6379
# URL interna de la API (fallback cuando Redis no tiene aaa:user:<user_ppp>)
API_INTERNAL_URL=http://localhost:3333
# Token para GET /internal/aaa/servicio
AAA_INTERNAL_TOKEN=
# Clave para descifrar pass_ppp (32 bytes en base64). Nunca la commitees.
AAA_PPP_KEY=
