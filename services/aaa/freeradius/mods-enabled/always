# -*- text -*-
#  Instancias de rlm_always: dan nombre a los códigos de retorno usados en sites-enabled/default
#  y en las políticas de policy.d de la imagen (filter_username usa "reject").
always reject {
	rcode = reject
}
always fail {
	rcode = fail
}
always ok {
	rcode = ok
}
always handled {
	rcode = handled
}
always invalid {
	rcode = invalid
}
always userlock {
	rcode = userlock
}
always notfound {
	rcode = notfound
}
always noop {
	rcode = noop
}
always updated {
	rcode = updated
}
