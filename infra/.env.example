# infra/.env — variables de docker compose (infra/docker-compose.yml).
#   cp infra/.env.example infra/.env
# docker compose lee infra/.env automáticamente porque el compose vive en infra/.
# Nunca commitees infra/.env (está en .gitignore). Aquí solo hay valores de desarrollo o marcadores.

# ---------------------------------------------------------------------------
# Perfiles
# ---------------------------------------------------------------------------
# "lab" agrega freeradius, aaa y coa. Déjalo vacío si solo trabajas en api/web/portal.
COMPOSE_PROFILES=lab
# Etiqueta de las imágenes construidas localmente (argosisp/api:dev, ...)
IMAGE_TAG=dev

# ---------------------------------------------------------------------------
# Comunes
# ---------------------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# PostgreSQL 16 (BD argosisp y argosisp_test)
# ---------------------------------------------------------------------------
# Tres usuarios (infra/postgres/usuarios.sh, se crean al iniciar un volumen nuevo):
#   argosisp        superusuario. Solo administración y la BD de pruebas argosisp_test (la misma
#                   contraseña que usa CI). Ninguna app del compose lo usa.
#   DB_OWNER_USER   dueño de la BD argosisp y de lo que crean las migraciones. Solo el servicio
#                   migrate (migraciones y seed).
#   DB_APP_USER     api, relay, workers y coa. Miembro del rol argosisp_app: DML en core, network,
#                   billing, ledger y notify; sin UPDATE/DELETE en ledger.asientos,
#                   ledger.movimientos ni audit.*; sin DDL.
# Valores de desarrollo: en cualquier servidor compartido o en producción, cambia las tres
# contraseñas (openssl rand -hex 24).
# Volumen creado antes de este cambio: los usuarios no existen y las tablas son del superusuario.
# En desarrollo recrea el volumen (docker compose down -v); ver infra/README.md.
DB_PASSWORD=argosisp
DB_OWNER_USER=argosisp_owner
DB_OWNER_PASSWORD=argosisp_owner
DB_APP_USER=argosisp_api
DB_APP_PASSWORD=argosisp_api
# Puerto publicado en 127.0.0.1 del host
DB_PORT_HOST=5432

# ---------------------------------------------------------------------------
# Redis 7 (AOF, maxmemory-policy noeviction, sin TTL)
# ---------------------------------------------------------------------------
REDIS_PORT_HOST=6379

# ---------------------------------------------------------------------------
# Correo de prueba (Mailpit): SMTP 1025, UI http://localhost:8025
# ---------------------------------------------------------------------------
SMTP_PORT_HOST=1025
MAILPIT_UI_PORT_HOST=8025
# Valor inicial del remitente (opcional; después se edita en el panel)
MAIL_FROM="ArgosIsp <no-responder@argosisp.example>"

# ---------------------------------------------------------------------------
# Notificaciones (servicio worker): Telegram y datos de la empresa en las plantillas
# ---------------------------------------------------------------------------
# El correo (SMTP) y Telegram se configuran DESDE EL PANEL (Configuración → Notificaciones),
# global y por empresa, con interruptores. Las variables SMTP_* (y MAIL_FROM) y TELEGRAM_BOT_TOKEN,
# TELEGRAM_BOT_NOMBRE, TELEGRAM_CHAT_EQUIPO y TELEGRAM_WEBHOOK_SECRET son OPCIONALES: solo sirven
# como valor inicial. Al arrancar, si la configuración global está vacía, la API y el worker la
# siembran con ellas una sola vez (queda en el log y en la bitácora); después mandan los valores
# del panel y estas variables se pueden borrar. En el compose de desarrollo apuntan a Mailpit.
# Token del bot de @BotFather. Vacío = sin Telegram (los clientes con esa preferencia reciben correo).
TELEGRAM_BOT_TOKEN=
# Usuario del bot sin @ (el portal arma https://t.me/<bot>?start=<código> para vincular el chat).
TELEGRAM_BOT_NOMBRE=
# Secreto del webhook (16 a 256 caracteres A-Z a-z 0-9 _ -), p. ej. `openssl rand -hex 32`.
# Vacío = POST /api/v1/telegram/webhook rechaza todo. Registrar con:
#   docker compose -f infra/docker-compose.yml exec api node ace.js telegram:webhook
TELEGRAM_WEBHOOK_SECRET=
# URL pública HTTPS base del webhook: https://<dominio>/api/v1/telegram/webhook (no es valor
# inicial: siempre se lee del entorno). `telegram:webhook` registra <base>/<id del bot>.
TELEGRAM_WEBHOOK_URL=
TELEGRAM_CODIGO_VIGENCIA_S=900
# Alertas internas al equipo (aaa caído, CoA fallido, caja con diferencia, crons atrasados):
# chat_id del grupo de Telegram del equipo, con el bot como miembro (p. ej. -1001234567890).
TELEGRAM_CHAT_EQUIPO=
# Avisos fiscales (integridad del libro rota, DTE rechazado, contingencia FEL, nota de crédito
# anulada): al chat del equipo y por correo a contabilidad (direcciones separadas por coma). Valor
# inicial, como el resto: después se edita en el panel (global o por empresa).
NOTIFY_CORREO_CONTABILIDAD=
NOTIFY_CRON_TOLERANCIA_MIN=30
NOTIFY_EMPRESA_NOMBRE=ArgosIsp
NOTIFY_EMPRESA_TELEFONO=
# URL del portal del cliente que aparece en los avisos
NOTIFY_PORTAL_URL=

# ---------------------------------------------------------------------------
# API (apps/api, AdonisJS, puerto 3333)
# ---------------------------------------------------------------------------
# Genera la tuya: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_KEY=
API_PORT_HOST=3333
# URL con la que el navegador llega a la API (panel y portal)
API_PUBLIC_URL=http://localhost:3333
# Conector Horus (se configura en el panel). true solo en laboratorio: permite http:// hacia Horus.
HORUS_PERMITIR_HTTP=false
# URL con la que el navegador llega al panel (autologin de Horus y enlace de conexión → /conectar).
# Vacía = http://localhost:<WEB_PORT_HOST>. Con el proxy público: https://<PROXY_DOMINIO_PANEL>.
PANEL_URL_PUBLICA=

# Pasarela de pago en línea (A3). La imagen de la API corre en producción: sin PASARELA_PROVEEDOR no
# hay pasarela (503). Laboratorio: PASARELA_PROVEEDOR=falsa, su secreto HMAC y la URL pública de la
# API para la página de pago simulada (vacía = API_PUBLIC_URL).
PASARELA_PROVEEDOR=
PASARELA_FALSA_SECRETO=
PASARELA_URL_PUBLICA=
# Orígenes adonde la pasarela devuelve al cliente al terminar de pagar (separados por coma).
# Vacía = el de PORTAL_URL_PUBLICA (la API también recibe PORTAL_URL_PUBLICA y arma
# <PORTAL_URL_PUBLICA>/corte?pago=<id>). Laboratorio: http://<portalFqdn>
PASARELA_RETORNO_ORIGENES=

# ---------------------------------------------------------------------------
# Proxy público (perfil publico, infra/proxy): TLS para la API y el panel
# ---------------------------------------------------------------------------
# Dominios públicos (Let's Encrypt). Con *.localhost Caddy usa un certificado interno.
PROXY_DOMINIO_API=api.localhost
PROXY_DOMINIO_PANEL=panel.localhost
# En producción: la IP pública y 80/443 (no la misma IP:80 que PORTAL_BIND_IP)
PROXY_BIND_IP=127.0.0.1
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443

# ---------------------------------------------------------------------------
# Frontends (Nuxt): panel 3000, portal 3001
# ---------------------------------------------------------------------------
WEB_PORT_HOST=3000
PORTAL_PORT_HOST=3001
# IP del host donde se publica el portal. En el laboratorio, la IP a la que el MikroTik hace
# dst-nat de la página de corte (ver infra/mikrotik/README.md).
PORTAL_BIND_IP=127.0.0.1
# Puerto de corte publicado en PORTAL_BIND_IP hacia el 3001 del portal (= portalCortePuerto de lab.rsc)
PORTAL_CORTE_PORT_HOST=80
# URL pública del portal (los Host ajenos reciben 302 a <URL>/corte) y hosts propios separados por coma
# (en el laboratorio: http://<portalFqdn> y <portalV4>,<portalV6> de lab.rsc)
PORTAL_URL_PUBLICA=
PORTAL_HOSTS=
# Cookie de sesión del portal con Secure: auto (si llegó por HTTPS) | siempre (PRODUCCIÓN, con el
# portal por HTTPS; docker-compose.portal-https.yml ya la fuerza en siempre)
PORTAL_COOKIE_SEGURA=auto
# Portal por HTTPS (docker-compose.portal-https.yml, infra/proxy/README.md "Portal por HTTPS"):
# dominio del portal (también en PORTAL_HOSTS), certificado y HSTS (s; empezar con 300, luego 31536000)
PORTAL_DOMINIO=portal.localhost
# internal (CA de Caddy, laboratorio) | /certs/portal.crt /certs/portal.key (archivos en PORTAL_TLS_DIR)
# | un correo (Let's Encrypt, solo con dominio público y el 80 abierto a internet)
PORTAL_TLS=internal
PORTAL_TLS_DIR=./proxy/portal-certs
PORTAL_HSTS_MAX_AGE=300
PORTAL_HTTPS_PORT_HOST=443

# ---------------------------------------------------------------------------
# Red de compose (subred fija) e IP real del cliente en el portal
# ---------------------------------------------------------------------------
COMPOSE_SUBNET_V4=172.30.0.0/24
COMPOSE_SUBNET_V6=fd00:a6:30::/64
# true en el perfil lab para que el portal reciba clientes por IPv6 conservando su IP
# (requiere el daemon de Docker con userland-proxy=false, ver infra/README.md)
COMPOSE_IPV6=false
# Proxies cuyo X-Forwarded-For acepta la API en /portal/quien-soy (por defecto, la red de compose)
PORTAL_PROXIES_CONFIABLES=172.30.0.0/24,fd00:a6:30::/64

# ---------------------------------------------------------------------------
# aaa / coa (perfil lab)
# ---------------------------------------------------------------------------
AAA_PORT_HOST=3100
COA_PORT_HOST=3200
# Token de aaa → GET /internal/aaa/servicio (lo valida apps/api). Genera uno aleatorio.
AAA_INTERNAL_TOKEN=
# Clave para cifrar/descifrar pass_ppp y radius_secret (formato v1): 32 bytes en base64.
# La reciben api (cifra), aaa y coa (descifran). Genera una y nunca la commitees:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AAA_PPP_KEY=
# Respaldo de aaa cuando Redis no tiene el servicio: api | fixtures
AAA_RESPALDO=api
# URL interna de la API para aaa y coa (respaldo por GET /internal/aaa/servicio con AAA_INTERNAL_TOKEN)
AAA_API_URL=http://api:3333/api/v1/
# Perfil de suspendido (opcionales; estos son los valores por defecto, ver infra/mikrotik/README.md)
AAA_SUSPENDIDO_RATE_LIMIT=256k/256k
AAA_SUSPENDIDO_GRUPO=suspendido
AAA_SUSPENDIDO_ADDRESS_LIST=suspendidos
AAA_SUSPENDIDO_FILTER_ID=argos-corte.in
# coa (A2): espera por respuesta del NAS, reintentos y la IP de origen que el router tiene en /radius
# (vacío = la que elija el sistema). El perfil de suspendido por CoA usa los AAA_SUSPENDIDO_* de arriba.
COA_TIMEOUT_MS=2000
COA_REINTENTOS=3
COA_ORIGEN_IP=
# Suspender sesiones con IPv6: coa (sin reconectar, IPv6 bloqueado) | disconnect (reconecta y redirige IPv6 a /corte)
COA_SUSPENDER_CON_IPV6=coa
# Vigía de aaa (servicio aaa-vigia, perfil lab): nodos nombre=url, caída tras N ms sin /health, frecuencia
AAA_SALUD_NODOS=aaa=http://aaa:3100
AAA_CAIDO_TRAS_MS=60000
AAA_SALUD_CADA_MS=5000
# Acct-Interim-Interval que entrega aaa (s). Lo usan aaa y sesiones-worker: debe ser el mismo en los dos
AAA_INTERIM_SEGUNDOS=300
# Sesiones colgadas (sesiones-worker, A2): cerrar las abiertas sin accounting en N × AAA_INTERIM_SEGUNDOS;
# revisar cada CADA_MS (0 lo apaga)
SESIONES_COLGADAS_INTERVALOS=3
SESIONES_COLGADAS_CADA_MS=300000

# ---------------------------------------------------------------------------
# RouterOS (servicio routeros-worker, A2): servicios sin PPPoE por la API REST de los routers
# ---------------------------------------------------------------------------
# Usuario y contraseña de cada router están en network.routers (cifrados con AAA_PPP_KEY).
# La verificación TLS es por router (api_tls_verificar y api_ca en network.routers, desde el panel o
# PUT /routers/:id); con certificado autofirmado en el laboratorio, cargar su CA en api_ca.
# ms por petición, reintentos ante red caída o 5xx y espera base del backoff
ROUTEROS_TIMEOUT_MS=5000
ROUTEROS_REINTENTOS=3
ROUTEROS_ESPERA_MS=500
# Interfaz del ARP estático (amarre IP-MAC) y servidor DHCP de los leases cuando el router no los define.
# Laboratorio (lab.rsc): ROUTEROS_DHCP_SERVIDOR=argos-dhcp-wisp
ROUTEROS_INTERFAZ_CLIENTES=
ROUTEROS_DHCP_SERVIDOR=all
# Reconciliación completa (ms) y sondeo de routers caídos (ms). El suspendido usa AAA_SUSPENDIDO_*.
ROUTEROS_RECONCILIAR_CADA_MS=900000
ROUTEROS_RECUPERAR_CADA_MS=30000

# ---------------------------------------------------------------------------
# FreeRADIUS 3.2 (perfil lab)
# ---------------------------------------------------------------------------
# IP del host donde se publican UDP 1812/1813.
#   127.0.0.1           solo pruebas locales (radtest dentro del contenedor)
#   IP LAN del servidor el MikroTik está en la misma LAN
#   10.255.255.1        IP del servidor en el túnel WireGuard hacia el MikroTik (ver lab.rsc)
RADIUS_BIND_IP=127.0.0.1
# Secret del cliente "localhost" (healthcheck y radtest). Genera uno: openssl rand -hex 16
RADIUS_LOCAL_SECRET=
# IP de origen del MikroTik del laboratorio (= /radius src-address en lab.rsc)
RADIUS_LAB_NAS_IP=10.255.255.2
# Secret compartido con el MikroTik (= variable radiusSecret de lab.rsc). openssl rand -hex 16
RADIUS_LAB_SECRET=

# Orígenes permitidos por CORS en la API (panel y portal).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Admin creado por el seed del servicio migrate. La API corre con NODE_ENV=production: sin estos dos valores no se crea.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Respaldos (servicio backup, infra/README.md "Respaldos")
# ---------------------------------------------------------------------------
# Hora UTC del pg_dump diario (03:13 UTC = 21:13 Guatemala). Si el contenedor estaba apagado, respalda al volver.
BACKUP_HORA=03:13
BACKUP_RETENCION_DIAS=14
# Directorio del host donde quedan los respaldos: un disco externo o un NFS montado (relativo a infra/)
BACKUP_HOST_DIR=./backups/datos
# rclone.conf para la copia remota y, solo al restaurar, age.key (relativo a infra/)
BACKUP_CONFIG_DIR=./backups/config
# Claves públicas de age (age-keygen) separadas por espacio. Vacío = respaldos sin cifrar.
# La clave privada NO va en este servidor: se guarda aparte y se monta solo para restaurar.
BACKUP_AGE_RECIPIENTS=
# Destino de rclone (p. ej. s3:argosisp-respaldos/prod, remoto definido en config/rclone.conf). Vacío = solo local.
BACKUP_RCLONE_DESTINO=

# ---------------------------------------------------------------------------
# Comprobantes de depósito (archivos que suben los clientes; no viven en Postgres)
# ---------------------------------------------------------------------------
# Dónde quedan en el host. Por defecto el volumen de Docker `comprobantes`; también acepta una ruta
# del host (./comprobantes o /srv/argosisp/comprobantes, relativa a infra/). Se monta en /comprobantes
# (COMPROBANTES_DIR de la API) en api y en backup; comprobantes-permisos la deja a nombre del usuario
# node (uid 1000) de la imagen de api, sin acceso para otros. El respaldo diario incluye un tar
# (comprimido y cifrado igual que el dump, misma retención).
COMPROBANTES_HOST_DIR=comprobantes

# ---------------------------------------------------------------------------
# Monitoreo (perfil monitoreo: COMPOSE_PROFILES=lab,monitoreo; infra/monitoring/README.md)
# ---------------------------------------------------------------------------
# Bearer de GET /metrics de api, aaa y coa (Prometheus manda el mismo a los tres): openssl rand -hex 24.
# Vacío = /metrics de la API responde 404 (y el job api queda en down); aaa y coa lo dejan abierto en la
# red interna. En el laboratorio y en producción, ponle valor.
METRICS_TOKEN=cambia-este-token-de-metricas
PROMETHEUS_PORT_HOST=9090
PROMETHEUS_RETENCION=30d
# Alertmanager (perfil monitoreo): manda las alertas de Prometheus al chat del equipo con el mismo
# TELEGRAM_BOT_TOKEN y TELEGRAM_CHAT_EQUIPO de arriba. Sin alguno de los dos, no envía nada.
# TELEGRAM_API_ROOT: solo para un servidor Bot API propio (vacío = https://api.telegram.org).
TELEGRAM_API_ROOT=
ALERTMANAGER_PORT_HOST=9093
ALERTMANAGER_RETENCION=120h
