# GenieACS en su propio servidor. Copia a .env y llena. Ver README.md (paso a paso).

# Nombre del servidor (DNS tipo A apuntando a la IP pública de este servidor)
ACS_DOMINIO=acs.tuisp.com.gt

# Certificado: "auto" (Let's Encrypt; necesita el DNS y el puerto 80 abierto) o "archivos"
TLS_MODO=auto
# Con TLS_MODO=auto: correo para los avisos de Let's Encrypt
ACME_EMAIL=soporte@tuisp.com.gt
# Con TLS_MODO=archivos: carpeta con fullchain.pem y privkey.pem
CERTS_DIR=./certs

# Usuario y clave con los que Argos entra al NBI. La clave va como hash bcrypt, ENTRE COMILLAS SIMPLES
# (lleva signos $). Generarlo: docker run --rm caddy:2.8.4 caddy hash-password --plaintext 'LA-CLAVE'
# La clave en claro se pega en Argos (Configuración › Integraciones › Equipos), nunca aquí.
NBI_USUARIO=argos
NBI_CLAVE_HASH='$2a$14$reemplaza.este.hash.por.el.de.tu.clave..................'
# IP públicas de los servidores de Argos (separadas por espacio). Solo ellas llegan al NBI.
NBI_IPS_PERMITIDAS=203.0.113.10/32

# Interfaz web de GenieACS (https://ACS_DOMINIO:3443): usuario y clave del proxy y desde qué IP
UI_USUARIO=admin
UI_CLAVE_HASH='$2a$14$reemplaza.este.hash.por.el.de.tu.clave..................'
UI_IPS_PERMITIDAS=203.0.113.10/32

# Secreto de las sesiones de la interfaz web (largo y aleatorio): openssl rand -hex 64
GENIEACS_UI_JWT_SECRET=

# Puertos hacia los equipos: 7547 (TR-069) siempre; 7567 (firmware) solo si lo usas
CWMP_INTERFAZ=0.0.0.0
FS_INTERFAZ=127.0.0.1

# Respaldo diario de MongoDB: hora (UTC, 08 = 2:00 de Guatemala), días que se guardan y carpeta
RESPALDO_HORA_UTC=08
RESPALDO_DIAS=14
RESPALDO_DIR=./respaldos
