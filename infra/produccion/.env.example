# /opt/argosisp/.env — configuración de PRODUCCIÓN (infra/produccion/docker-compose.produccion.yml).
# instalar.sh lo genera solo, con contraseñas y claves aleatorias, y lo deja en 600 (solo root).
# Este archivo es la referencia de las variables; los valores de aquí son marcadores, nunca uses
# estos en un servidor. CI lo usa para `docker compose config`.
# Después de editar el .env real: argosisp levantar

# Versión instalada: la cambia `argosisp actualizar` (no la edites a mano)
ARGOSISP_VERSION=1.0.0
# Registro de las imágenes (ghcr.io/<dueño del repositorio en minúsculas>)
ARGOSISP_REGISTRO=ghcr.io/hcdestroyer

# Dominios (registros A/AAAA hacia este servidor). instalar.sh: panel.<d>, api.<d> y portal.<d>
DOMINIO_PANEL=panel.miisp.example
DOMINIO_API=api.miisp.example
DOMINIO_PORTAL=portal.miisp.example
# Conectar Iris con un botón (contrato Iris §1.4): orígenes de Iris (https://host[:puerto],
# separados por espacios) que no piden escribir el dominio para confirmar. Vacía = solo el conector.
ARGOSISP_IRIS_ORIGENES=
# Opciones globales de Caddy: "email <correo>" (Let's Encrypt avisa vencimientos) o local_certs
PROXY_TLS_GLOBAL="email admin@miisp.example"
# HSTS del portal (segundos). Empieza en 300; sube a 31536000 cuando el certificado funcione
PORTAL_HSTS_MAX_AGE=300
# IP y puertos del proxy (80 = /corte de los suspendidos y retos de Let's Encrypt; 443 = HTTPS)
ARGOSISP_BIND_IP=0.0.0.0
ARGOSISP_HTTP_PORT=80
ARGOSISP_HTTPS_PORT=443
# Detrás de otro proxy (Nginx Proxy Manager en 80/443): IP o CIDR del proxy, separados por espacio
# (p. ej. "172.30.0.1/32" si NPM corre en Docker en este mismo servidor). Solo de esas conexiones
# Caddy toma la IP del cliente de X-Forwarded-For / X-Real-IP. Vacía = no hay proxy delante.
# Nunca pongas aquí las redes de los clientes. docs/runbooks/detras-de-proxy.md
ARGOSISP_PROXIES_CONFIABLES=
# Red de compose (opcional): cámbiala si 172.30.0.0/24 choca con tu LAN (instalar.sh la escribe
# si la recibe en el entorno). La API confía en el X-Forwarded-For de Caddy y del portal desde esta
# subred (PORTAL_PROXIES_CONFIABLES la sigue sola; no la fijes salvo que sepas por qué).
# COMPOSE_SUBNET_V4=172.30.0.0/24
# COMPOSE_SUBNET_V6=fd00:a6:30::/64

# API del portal (servicio api-portal: la misma API, misma base y Redis, solo para el tráfico de
# los clientes). si | no. Si falta: si, salvo con menos de 3 GB de RAM (no). `argosisp` la escribe.
ARGOSISP_API_PORTAL=si
# Destinos fijos a mano (vacíos = los de este compose). URL que usa Nitro para /api/v1/portal/**,
# upstream host:puerto de Caddy para /api/v1/portal/* del host de la API, y base/Redis de api-portal.
PORTAL_API_URL_INTERNA=
API_PORTAL_UPSTREAM=
API_PORTAL_DB_HOST=
API_PORTAL_DB_PORT=
API_PORTAL_REDIS_HOST=
API_PORTAL_REDIS_PORT=

# Administrador inicial (lo crea el seed al instalar; después se cambia la clave en el panel)
SEED_ADMIN_EMAIL=admin@miisp.example
SEED_ADMIN_PASSWORD=cambia-esto

# Claves de la aplicación. AAA_PPP_KEY = 32 bytes en base64 (cifra las contraseñas PPPoE y los
# secrets RADIUS): si se pierde, no se pueden leer. Guarda una copia del .env fuera del servidor.
APP_KEY=marcador-de-48-caracteres-aleatorios-0123456789
AAA_PPP_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AAA_INTERNAL_TOKEN=marcador
RADIUS_LOCAL_SECRET=marcador
# Bearer de GET /metrics (Prometheus). Vacío = /metrics apagado
METRICS_TOKEN=
TELEGRAM_WEBHOOK_SECRET=marcador-de-telegram-0123456789

# PostgreSQL (infra/postgres/usuarios.sh): superusuario, dueño (migrate) y aplicación
DB_PASSWORD=marcador
DB_OWNER_USER=argosisp_owner
DB_OWNER_PASSWORD=marcador
DB_APP_USER=argosisp_api
DB_APP_PASSWORD=marcador

# Respaldos (infra/backups; infra/README.md "Respaldos")
BACKUP_HOST_DIR=/opt/argosisp/respaldos
BACKUP_CONFIG_DIR=/opt/argosisp/respaldos-config
BACKUP_HORA=03:13
BACKUP_RETENCION_DIAS=14
BACKUP_AGE_RECIPIENTS=
BACKUP_RCLONE_DESTINO=

# WireGuard de los routers (infra/wireguard/README.md). 1 = los MikroTik se conectan por el túnel con
# el script de conexión del panel; RADIUS queda en la .1 del túnel (RADIUS_BIND_IP=10.255.0.1)
ARGOSISP_WIREGUARD=0
ARGOSISP_WG_RED=10.255.0.0/16
ARGOSISP_WG_PUERTO=51820
# Nombre o IPv4 pública a la que llegan los routers por UDP (vacío = DOMINIO_API). Si DOMINIO_API
# pasa por un proxy HTTP (Cloudflare, Nginx Proxy Manager), pon aquí la IP pública del servidor.
ARGOSISP_WG_ENDPOINT=

# Script de conexión con «incluir configuración de servicio» (PPPoE, perfiles y corte en un router
# nuevo). Son datos de TU red de clientes: no tienen valor por defecto. Si falta alguno, el panel lo
# dice (servicio_incompleto) y el script solo de conexión sigue funcionando. Listas separadas por coma.
# El portal sale de DOMINIO_PORTAL, la interfaz PPPoE de la ficha del router y el rate-limit del corte
# de AAA_SUSPENDIDO_RATE_LIMIT. Ejemplos (los de lab.rsc) entre paréntesis.
# Interfaz de salida a internet del router (ether1)
ROUTERS_SERVICIO_WAN_INTERFAZ=
# IP del router en los enlaces PPP y DNS de los clientes (10.10.0.1)
ROUTERS_SERVICIO_PPP_LOCAL_V4=
# Pool dinámico PPPoE (10.10.0.10-10.10.0.250) y prefijo de todos los clientes (10.10.0.0/16)
ROUTERS_SERVICIO_POOL_V4_RANGOS=
ROUTERS_SERVICIO_CLIENTES_V4=
# Prefijos IPv6 de clientes (2001:db8:100::/48,2001:db8:200::/40), pool de /64 de enlace y de /56 delegados
ROUTERS_SERVICIO_CLIENTES_V6=
ROUTERS_SERVICIO_POOL_V6_ENLACE_PREFIJO=
ROUTERS_SERVICIO_POOL_V6_PD_PREFIJO=
# IPv4 e IPv6 del portal a las que el router manda a los suspendidos (las de este servidor)
ROUTERS_SERVICIO_PORTAL_V4=
ROUTERS_SERVICIO_PORTAL_V6=
# Dominios del walled garden además del portal (app.recurrente.com con la pasarela Recurrente)
ROUTERS_SERVICIO_WALLED_GARDEN=
# Resolutores DNS del router (al menos uno IPv4)
ROUTERS_SERVICIO_DNS_V4=
ROUTERS_SERVICIO_DNS_V6=

# RADIUS y CoA (infra/mikrotik/README.md). Con ARGOSISP_WIREGUARD=1: la .1 de ARGOSISP_WG_RED
RADIUS_BIND_IP=0.0.0.0
# Vacía en producción: coa corre en red bridge y la IP de origen de los CoA la pone el NAT del
# servidor (la del servidor hacia el router, la que el MikroTik tiene en /radius). Con la IP del
# servidor aquí el bind falla dentro del contenedor
COA_ORIGEN_IP=
COA_SUSPENDER_CON_IPV6=coa
AAA_SALUD_NODOS=aaa=http://aaa:3100
# aaa junta en un lote las consultas a la API que llegan a la vez; 0 = una GET por usuario.
# Para cambiarla: editar aquí y `sudo argosisp levantar`
AAA_API_LOTES=1

# Correo y Telegram: se configuran en el panel. Estas solo siembran la configuración la primera vez
MAIL_FROM="ArgosIsp <no-responder@miisp.example>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NOMBRE=
TELEGRAM_CHAT_EQUIPO=
NOTIFY_EMPRESA_NOMBRE=ArgosIsp
NOTIFY_EMPRESA_TELEFONO=

# Pasarela de pago en línea (A3). Vacío = sin pasarela; recurrente = la pasarela real
PASARELA_PROVEEDOR=
# Recurrente: llave secreta (sk_live_…) y secreto de firma del webhook (whsec_…), que da Recurrente
# al registrar https://<DOMINIO_API>/api/v1/pasarela/webhook/recurrente. El firewall del servidor debe
# aceptar las IP de Svix (https://docs.svix.com/webhook-ips). Nunca en el repo.
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRETO=
