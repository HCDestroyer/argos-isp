# /opt/argosisp/.env — configuración de PRODUCCIÓN (infra/produccion/docker-compose.produccion.yml).
# instalar.sh lo genera solo, con contraseñas y claves aleatorias, y lo deja en 600 (solo root).
# Este archivo es la referencia de las variables; los valores de aquí son marcadores, nunca uses
# estos en un servidor. CI lo usa para `docker compose config`.
# Después de editar el .env real: argosisp levantar

# Versión instalada: la cambia `argosisp actualizar` (no la edites a mano)
ARGOSISP_VERSION=1.0.0
# Registro de las imágenes (ghcr.io/<dueño del repositorio en minúsculas>)
ARGOSISP_REGISTRO=ghcr.io/hcdestroyer

# Dominios (registros A/AAAA hacia este servidor). instalar.sh: panel.<d>, api.<d> y portal.<d>
DOMINIO_PANEL=panel.miisp.example
DOMINIO_API=api.miisp.example
DOMINIO_PORTAL=portal.miisp.example
# Opciones globales de Caddy: "email <correo>" (Let's Encrypt avisa vencimientos) o local_certs
PROXY_TLS_GLOBAL="email admin@miisp.example"
# HSTS del portal (segundos). Empieza en 300; sube a 31536000 cuando el certificado funcione
PORTAL_HSTS_MAX_AGE=300
# IP y puertos del proxy (80 = /corte de los suspendidos y retos de Let's Encrypt; 443 = HTTPS)
ARGOSISP_BIND_IP=0.0.0.0
ARGOSISP_HTTP_PORT=80
ARGOSISP_HTTPS_PORT=443

# API del portal (servicio api-portal: la misma API, misma base y Redis, solo para el tráfico de
# los clientes). si | no. Si falta: si, salvo con menos de 3 GB de RAM (no). `argosisp` la escribe.
ARGOSISP_API_PORTAL=si
# Destinos fijos a mano (vacíos = los de este compose). URL que usa Nitro para /api/v1/portal/**,
# upstream host:puerto de Caddy para /api/v1/portal/* del host de la API, y base/Redis de api-portal.
PORTAL_API_URL_INTERNA=
API_PORTAL_UPSTREAM=
API_PORTAL_DB_HOST=
API_PORTAL_DB_PORT=
API_PORTAL_REDIS_HOST=
API_PORTAL_REDIS_PORT=

# Administrador inicial (lo crea el seed al instalar; después se cambia la clave en el panel)
SEED_ADMIN_EMAIL=admin@miisp.example
SEED_ADMIN_PASSWORD=cambia-esto

# Claves de la aplicación. AAA_PPP_KEY = 32 bytes en base64 (cifra las contraseñas PPPoE y los
# secrets RADIUS): si se pierde, no se pueden leer. Guarda una copia del .env fuera del servidor.
APP_KEY=marcador-de-48-caracteres-aleatorios-0123456789
AAA_PPP_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
AAA_INTERNAL_TOKEN=marcador
RADIUS_LOCAL_SECRET=marcador
# Bearer de GET /metrics (Prometheus). Vacío = /metrics apagado
METRICS_TOKEN=
TELEGRAM_WEBHOOK_SECRET=marcador-de-telegram-0123456789

# PostgreSQL (infra/postgres/usuarios.sh): superusuario, dueño (migrate) y aplicación
DB_PASSWORD=marcador
DB_OWNER_USER=argosisp_owner
DB_OWNER_PASSWORD=marcador
DB_APP_USER=argosisp_api
DB_APP_PASSWORD=marcador

# Respaldos (infra/backups; infra/README.md "Respaldos")
BACKUP_HOST_DIR=/opt/argosisp/respaldos
BACKUP_CONFIG_DIR=/opt/argosisp/respaldos-config
BACKUP_HORA=03:13
BACKUP_RETENCION_DIAS=14
BACKUP_AGE_RECIPIENTS=
BACKUP_RCLONE_DESTINO=

# RADIUS y CoA (infra/mikrotik/README.md)
RADIUS_BIND_IP=0.0.0.0
# Vacía en producción: coa corre en red bridge y la IP de origen de los CoA la pone el NAT del
# servidor (la del servidor hacia el router, la que el MikroTik tiene en /radius). Con la IP del
# servidor aquí el bind falla dentro del contenedor
COA_ORIGEN_IP=
COA_SUSPENDER_CON_IPV6=coa
AAA_SALUD_NODOS=aaa=http://aaa:3100

# Correo y Telegram: se configuran en el panel. Estas solo siembran la configuración la primera vez
MAIL_FROM="ArgosIsp <no-responder@miisp.example>"
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NOMBRE=
TELEGRAM_CHAT_EQUIPO=
NOTIFY_EMPRESA_NOMBRE=ArgosIsp
NOTIFY_EMPRESA_TELEFONO=

# Pasarela de pago en línea (A3). Vacío = sin pasarela
PASARELA_PROVEEDOR=
