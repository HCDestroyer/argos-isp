# /opt/argosisp/.env de un NODO PORTAL (infra/produccion/docker-compose.nodo-portal.yml).
# Lo genera `instalar.sh --rol portal` (600). Referencia de las variables; los valores son
# marcadores. CI lo usa para `docker compose config`. Después de editar el real: argosisp levantar
ARGOSISP_ROL=portal
ARGOSISP_PROYECTO=argosisp-portal
ARGOSISP_VERSION=1.0.0
ARGOSISP_REGISTRO=ghcr.io/hcdestroyer

# Dominio del portal de este nodo, certificados y HSTS (como en el principal)
DOMINIO_PORTAL=portal.miisp.example
PROXY_TLS_GLOBAL="email admin@miisp.example"
PORTAL_HSTS_MAX_AGE=300
ARGOSISP_HTTP_PORT=80
ARGOSISP_HTTPS_PORT=443

# API central y token del nodo (`argosisp nodo-portal crear` en el principal; se ve una sola vez)
NODO_CENTRAL_URL=https://api.miisp.example
NODO_CENTRAL_HOST=api.miisp.example
# host:puerto al que se conecta el proxy (por defecto NODO_CENTRAL_HOST:443)
NODO_CENTRAL_DIRECCION=api.miisp.example:443
# Solo pruebas con la CA interna del central: tls_insecure_skip_verify
NODO_CENTRAL_TLS_EXTRA=
NODO_PORTAL_TOKEN=cambia-esto-por-el-token-del-nodo
