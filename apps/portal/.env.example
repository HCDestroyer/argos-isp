# apps/api vista desde el servidor Nitro del portal (sin ruta). El navegador nunca la usa:
# llama a /api/v1/portal/** en el mismo origen y Nitro reenvía aquí con X-Forwarded-For.
NUXT_API_BASE_INTERNAL=http://localhost:3333

# Vacío (recomendado): el navegador llama a la API a través del portal (mismo origen, sin CORS,
# el walled garden solo necesita el portal). Con una URL, el navegador llama a la API directo.
NUXT_PUBLIC_API_BASE=

# Portal cautivo: el MikroTik manda TCP/80 de los suspendidos al portal con cualquier Host.
# Peticiones con un Host que no es del portal, y las pruebas de conectividad de los sistemas
# operativos (/generate_204, /hotspot-detect.html, /ncsi.txt…), reciben 302 a /corte.
# URL pública del portal (= portalFqdn de infra/mikrotik/lab.rsc). Vacía: redirección relativa a
# /corte en el mismo Host ajeno (funciona sin DNS, p. ej. en el laboratorio).
NUXT_PORTAL_URL_PUBLICA=
# Otros nombres o IPs con los que se entra al portal (sin puerto, separados por coma), p. ej. la
# portalV4 y portalV6 de lab.rsc. localhost, 127.0.0.1 y ::1 siempre cuentan como el portal.
NUXT_PORTAL_HOSTS=

# "Seguir navegando" en /corte cuando el servicio se reactiva. Mejor una URL HTTP (el sistema
# operativo vuelve a probar la conexión). No hace falta en el walled garden.
NUXT_PUBLIC_SEGUIR_NAVEGANDO_URL=http://example.com/

# true: useApi() y la página de corte responden desde apps/portal/fixtures sin backend.
# En fixtures, /corte?fixture=activo|suspendido|desconocido|reactivacion elige el escenario
# (reactivacion: suspendido con promesa; /portal/estado responde activo desde la 2.ª consulta).
NUXT_PUBLIC_USE_FIXTURES=false

# Nombre de la empresa mientras carga GET /api/v1/portal/empresa. Teléfonos, WhatsApp, correo,
# horario, instrucciones de pago y cuentas de depósito se configuran en el panel (PUT /empresa y
# /cuentas-bancarias de A3), ya no aquí.
NUXT_PUBLIC_EMPRESA_NOMBRE=ArgosIsp

# Puerto del servidor Nitro en producción (node .output/server/index.mjs).
PORT=3001
