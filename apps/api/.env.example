# --------------------------------------------------------------------
# @argosisp/api · variables de entorno
# Copia este archivo a `.env` para desarrollo. Nunca subas `.env`.
# --------------------------------------------------------------------

# Entorno: development | production | test
NODE_ENV=development
# Puerto HTTP de la API (el Dockerfile y docker-compose esperan 3333)
PORT=3333
HOST=0.0.0.0
# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Clave de la app (cifrado y firmas). Genera una con `node ace generate:key`.
# En producción debe ser un secreto de al menos 32 caracteres.
APP_KEY=cambia-esta-clave-de-desarrollo-32chars

# PostgreSQL 16. En producción el usuario debe ser miembro del rol
# `argosisp_app` (sin UPDATE/DELETE en ledger.asientos, ledger.movimientos y audit.*).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=argosisp
DB_PASSWORD=argosisp
DB_DATABASE=argosisp
# Tamaño máximo del pool de conexiones (opcional, por defecto 10)
DB_POOL_MAX=10

# Redis 7 (BullMQ, relay de outbox, cachés de RADIUS). Opcional hoy; lo usan A1/A2/A3.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Token compartido para endpoints /api/v1/internal/* (servicio aaa, coa).
# Se envía como `Authorization: Bearer <INTERNAL_TOKEN>`.
INTERNAL_TOKEN=token-interno-de-desarrollo
# Vigencia de los tokens de sesión del login (formato '12h', '7d'). Opcional; por defecto 12h.
ACCESS_TOKEN_EXPIRA=12h
# Orígenes permitidos por CORS separados por coma (vacío = mismo origen y localhost en dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Usuario administrador que crea `pnpm seed`. Los valores por defecto
# (admin@argosisp.local / admin12345) SOLO existen para desarrollo y laboratorio;
# en cualquier otro entorno defínelos explícitamente.
SEED_ADMIN_EMAIL=admin@argosisp.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NOMBRE=Administrador

# Solo para la imagen Docker: ejecuta `node ace migration:run --force` al iniciar.
RUN_MIGRATIONS=false
