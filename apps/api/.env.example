# --------------------------------------------------------------------
# @argosisp/api · variables de entorno
# Copia este archivo a `.env` para desarrollo. Nunca subas `.env`.
# --------------------------------------------------------------------

# Entorno: development | production | test
NODE_ENV=development
# Puerto HTTP de la API (el Dockerfile y docker-compose esperan 3333)
PORT=3333
HOST=0.0.0.0
# Nivel de log de pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Clave de la app (cifrado y firmas). Genera una con `node ace generate:key`.
# En producción debe ser un secreto de al menos 32 caracteres.
APP_KEY=cambia-esta-clave-de-desarrollo-32chars

# PostgreSQL 16. En producción el usuario debe ser miembro del rol
# `argosisp_app` (sin UPDATE/DELETE en ledger.asientos, ledger.movimientos y audit.*).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=argosisp
DB_PASSWORD=argosisp
DB_DATABASE=argosisp
# Tamaño máximo del pool de conexiones (opcional, por defecto 10)
DB_POOL_MAX=10

# Redis 7 (BullMQ, relay de outbox, cachés de RADIUS).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Prefijo de las claves de BullMQ en Redis (opcional, por defecto argosisp)
COLAS_PREFIJO=argosisp

# Cachés y bus de eventos (A1). Opcionales: los valores por defecto son los del contrato
# (`.claude/integration/contratos/`). En NODE_ENV=test se anteponen COLAS_PREFIJO para aislar.
# Prefijo de las claves de autorización RADIUS (aaa:user:<user_ppp>); el mismo que AAA_REDIS_PREFIJO de services/aaa.
AAA_REDIS_PREFIJO=aaa:user:
# Stream del outbox (relay: node ace eventos:relay)
EVENTOS_STREAM=argos:eventos

# Notificaciones (app/notify). Correo y Telegram se configuran desde el panel
# (PUT /api/v1/notificaciones/configuracion), global y por empresa. SMTP_*, MAIL_FROM,
# TELEGRAM_BOT_TOKEN, TELEGRAM_BOT_NOMBRE, TELEGRAM_CHAT_EQUIPO y TELEGRAM_WEBHOOK_SECRET son
# opcionales: solo siembran la configuración global la primera vez que arranca la API o el
# worker (si está vacía); después mandan los valores del panel. Mientras no haya configuración
# guardada, rigen estas variables. Mailpit en desarrollo: SMTP 1025, UI 8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="ArgosIsp <no-responder@argosisp.local>"
# Bot de Telegram (@BotFather). Vacío = sin Telegram: los clientes con esa preferencia reciben correo.
TELEGRAM_BOT_TOKEN=
# Raíz de la Bot API (opcional; solo para un servidor Bot API propio)
TELEGRAM_API_ROOT=
# Bot de Telegram (contratos/telegram.md): usuario del bot sin @ (arma t.me/<bot>?start=<código>),
# secreto del webhook (16 a 256 caracteres A-Z a-z 0-9 _ -; Telegram lo manda en
# X-Telegram-Bot-Api-Secret-Token; vacío = el webhook rechaza todo), URL pública HTTPS del webhook
# para `node ace telegram:webhook` y vigencia (s) del código de vinculación.
TELEGRAM_BOT_NOMBRE=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_CODIGO_VIGENCIA_S=900
# Intentos por envío antes de marcarlo fallido (backoff exponencial desde 5 s)
NOTIFY_INTENTOS=5
# Datos de la empresa disponibles en las plantillas como {{empresa.*}}
NOTIFY_EMPRESA_NOMBRE=ArgosIsp
NOTIFY_EMPRESA_TELEFONO=
NOTIFY_PORTAL_URL=http://localhost:3001
# URL pública de la API (sin /api/v1) para {{empresa.logo_url}} en los avisos; vacía = sin logo
NOTIFY_API_URL=
# Conector Horus (A6): se configura desde el panel. URL pública de la API (receptor de webhooks y
# enlace de conexión; vacía = NOTIFY_API_URL o la de la petición) y flag de laboratorio para http://.
API_PUBLIC_URL=
HORUS_PERMITIR_HTTP=false
# Conector Iris (A1, contratos/iris.md): se configura desde el panel o con el enlace de conexión.
# Flag de laboratorio para hablar con Iris por http:// (en producción, solo https://).
IRIS_PERMITIR_HTTP=false
# Alertas internas (aaa caído, CoA fallido, caja con diferencia, crons atrasados): chat_id del grupo
# del equipo en Telegram (p. ej. -1001234567890; el bot debe estar en el grupo). Vacío = las alertas
# quedan como envíos fallidos en notify.envios, visibles en el panel.
TELEGRAM_CHAT_EQUIPO=
# Avisos fiscales (libro.integridad_rota, dte.rechazado, fel.contingencia_cambiada,
# nota_credito.anulada): además del chat del equipo, correo a contabilidad (direcciones separadas por
# coma). Valor inicial: después se edita en el panel (correo.contabilidad), global o por empresa.
NOTIFY_CORREO_CONTABILIDAD=
# Minutos de gracia antes de avisar que un cron de facturación o de corte no corrió a su hora
NOTIFY_CRON_TOLERANCIA_MIN=30

# GET /metrics (Prometheus): Authorization: Bearer <METRICS_TOKEN>. Vacío = /metrics responde 404.
METRICS_TOKEN=

# Vigía de aaa (node ace aaa:vigilar): nodos nombre=url separados por coma. Si un nodo no responde
# GET /health durante AAA_CAIDO_TRAS_MS emite aaa.caido por outbox; al volver, aaa.recuperado.
AAA_SALUD_NODOS=aaa=http://localhost:3100
AAA_CAIDO_TRAS_MS=60000
AAA_SALUD_CADA_MS=5000

# Sesiones colgadas (cron de node ace sesiones:worker): cierra con causa sin_interim las sesiones
# abiertas sin Interim-Update ni Stop en SESIONES_COLGADAS_INTERVALOS × AAA_INTERIM_SEGUNDOS (el mismo
# Acct-Interim-Interval que entrega aaa). Revisa cada SESIONES_COLGADAS_CADA_MS; 0 lo apaga.
AAA_INTERIM_SEGUNDOS=300
SESIONES_COLGADAS_INTERVALOS=3
SESIONES_COLGADAS_CADA_MS=300000
# Caídas repetidas (pedido A6 de Iris): servicio.caidas_repetidas cuando un servicio acumula
# CAIDAS_REPETIDAS_SESIONES sesiones terminadas en CAIDAS_REPETIDAS_VENTANA_MIN minutos, a lo sumo una
# vez por ventana. Las causas de CAIDAS_REPETIDAS_CAUSAS_IGNORADAS (separadas por comas) no cuentan:
# Admin-Reset (CoA/Disconnect de Argos), Admin-Reboot y NAS-Reboot (el router entero), NAS-Request y
# sin_interim (cierre del cron, sin dato del NAS). CAIDAS_REPETIDAS_SESIONES=0 lo apaga.
CAIDAS_REPETIDAS_SESIONES=5
CAIDAS_REPETIDAS_VENTANA_MIN=120
CAIDAS_REPETIDAS_CAUSAS_IGNORADAS=Admin-Reset,Admin-Reboot,NAS-Reboot,NAS-Request,sin_interim

# API REST de RouterOS (A2, `node ace routeros:worker`, servicios sin PPPoE). Usuario y contraseña
# salen de network.routers (api_usuario, api_password cifrada v1 con AAA_PPP_KEY).
# La verificación del certificado HTTPS es por router (network.routers.api_tls_verificar y api_ca):
# para un certificado autofirmado se carga su CA o se apaga en ese router.
# ms por petición, reintentos ante red caída/5xx (400 y 401 no se reintentan) y espera base del backoff
ROUTEROS_TIMEOUT_MS=5000
ROUTEROS_REINTENTOS=3
ROUTEROS_ESPERA_MS=500
# Suspendido: misma velocidad y address-list que PPPoE (AAA_SUSPENDIDO_* de aaa)
ROUTEROS_SUSPENDIDO_RATE_LIMIT=256k/256k
ROUTEROS_SUSPENDIDO_ADDRESS_LIST=suspendidos
# Interfaz del ARP estático (amarre IP-MAC) y servidor DHCP del lease cuando el router no los define
ROUTEROS_INTERFAZ_CLIENTES=
ROUTEROS_DHCP_SERVIDOR=all
# Reconciliación completa (ms) y sondeo de routers caídos (ms)
ROUTEROS_RECONCILIAR_CADA_MS=900000
ROUTEROS_RECUPERAR_CADA_MS=30000
# Contacto de los routers (Router.en_linea): sondeo de la API REST (GET /rest/system/resource) a los
# routers activos con credenciales y sin accounting ni respuesta en el último intervalo. Vacío =
# AAA_INTERIM_SEGUNDOS × 1000; 0 lo apaga. Un proceso no reescribe el mismo router antes de
# ROUTERS_CONTACTO_MINIMO_S (el Interim-Update de cada sesión no escribe cada vez).
ROUTEROS_SONDEO_CADA_MS=
ROUTERS_CONTACTO_MINIMO_S=60

# Token compartido para endpoints /api/v1/internal/* (servicio aaa, coa).
# Se envía como `Authorization: Bearer <INTERNAL_TOKEN>`.
INTERNAL_TOKEN=token-interno-de-desarrollo
# Clave AES-256-GCM (32 bytes en base64) con la que se cifran pass_ppp, radius_secret y
# api_password (formato v1). La MISMA clave va en services/aaa y services/coa.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Este valor SOLO sirve para desarrollo.
AAA_PPP_KEY=Y2xhdmUtZGUtZGVzYXJyb2xsby1hYWEtcHBwLTMyYnk=
# Vigencia de los tokens Bearer de POST /auth/login (formato '12h', '7d'). Opcional; por defecto 12h.
# No aplica a la cookie del panel (abajo).
ACCESS_TOKEN_EXPIRA=12h
# Orígenes permitidos (CORS con credenciales y `Origin` de la sesión por cookie del panel),
# separados por coma. Vacío = mismo origen, más localhost/127.0.0.1 en cualquier puerto fuera de
# producción. Nunca se refleja un origen cualquiera.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# `Secure` de la cookie HttpOnly del panel (POST /auth/sesion). Por defecto true; `false` solo para
# desarrollo por http con una IP o nombre que no sea localhost.
PANEL_COOKIE_SEGURA=true
# Sesión deslizante del panel (cookie): cada petición la renueva hasta ahora + INACTIVIDAD, sin pasar
# de login + MAXIMA. Horas; admiten decimales. Por defecto 12 h sin uso y 72 h (3 días) de tope.
PANEL_SESION_INACTIVIDAD_H=12
PANEL_SESION_MAXIMA_H=72

# Usuario administrador que crea `pnpm seed`. Los valores por defecto
# (admin@argosisp.local / admin12345) SOLO existen para desarrollo y laboratorio;
# en cualquier otro entorno defínelos explícitamente.
SEED_ADMIN_EMAIL=admin@argosisp.local
SEED_ADMIN_PASSWORD=admin12345
SEED_ADMIN_NOMBRE=Administrador

# Solo para la imagen Docker: ejecuta `node ace migration:run --force` al iniciar.
RUN_MIGRATIONS=false

# IP real del cliente: portal (GET /portal/quien-soy) y límite de login por IP. IPs o CIDR del portal y
# de los proxies delante (Caddy), separados por coma (p. ej. 127.0.0.1,::1 en desarrollo). Solo desde
# ellas se cree X-Forwarded-For; vacía = IP del socket.
PORTAL_PROXIES_CONFIABLES=
# Cabecera con la IP del cliente (por defecto x-forwarded-for).
PORTAL_CABECERA_IP=x-forwarded-for
# Límite por IP (IPv6: por /64) de cada ruta /portal/* (contador propio por ruta): peticiones por ventana; 0 lo apaga.
# Al pasarse: 429 problem+json con Retry-After. Contadores en Redis (REDIS_*).
PORTAL_LIMITE_PETICIONES=30
PORTAL_LIMITE_VENTANA_S=60
# Prefijo de las claves del portal en Redis: límite y ventana de auditoría (vacío = COLAS_PREFIJO o argosisp).
PORTAL_REDIS_PREFIJO=
# quien-soy y estado se auditan una vez por IP + servicio en esta ventana (segundos); 0 audita todas.
PORTAL_AUDITORIA_VENTANA_S=600
# Acceso al portal con código (POST /portal/codigo y /portal/verificar). El código va al correo o
# Telegram registrado del cliente por los canales de notify (SMTP_*, TELEGRAM_BOT_TOKEN).
# Vigencia del código (s), intentos por código y códigos por cliente por hora.
PORTAL_CODIGO_VIGENCIA_S=600
PORTAL_CODIGO_INTENTOS=5
PORTAL_CODIGO_MAX_HORA=5
# Sesión del portal (cookie httpOnly argos_portal): cierre por inactividad y duración máxima (s).
PORTAL_SESION_INACTIVIDAD_S=1800
PORTAL_SESION_MAX_S=14400
# Atributo Secure de esa cookie. auto: solo si la petición llegó por HTTPS (TLS en la API, o
# X-Forwarded-Proto=https desde un proxy de PORTAL_PROXIES_CONFIABLES). siempre: en producción con
# el portal publicado por HTTPS detrás de un proxy que termina TLS (docs/seguridad/portal.md).
PORTAL_COOKIE_SEGURA=auto
# URL pública del portal (esquema://host[:puerto], sin ruta). "Pagar en línea" pide a la pasarela que
# devuelva al cliente a <PORTAL_URL_PUBLICA>/corte?pago=<id>&estado=<pagado|fallido>. Vacía: NOTIFY_PORTAL_URL;
# sin ninguna, el cliente vuelve con "Atrás". Su origen debe estar en PASARELA_RETORNO_ORIGENES.
PORTAL_URL_PUBLICA=
# URL pública del panel (esquema://host[:puerto], sin ruta). Los tickets de autologin que pide Horus
# (contrato horus §1.5) abren <PANEL_URL_PUBLICA>/sso/entrar#<ticket>, y el enlace de conexión con
# Horus (<API_PUBLIC_URL>/conectar#<código>, §1.4) abierto en el navegador redirige a
# <PANEL_URL_PUBLICA>/conectar. Vacía: http://localhost:3000 en desarrollo; en producción el
# autologin y esa redirección responden 503 sso_no_configurado.
PANEL_URL_PUBLICA=

# Comprobantes de depósito (app/billing): carpeta local donde se guardan las fotos y PDF que suben
# el portal y el panel (nunca en la base). Relativa a apps/api o absoluta; por defecto storage/comprobantes.
# En Docker debe ser un volumen persistente y respaldado.
COMPROBANTES_DIR=storage/comprobantes

# Pasarela de pago en línea (app/billing/pasarelas). Sin PASARELA_PROVEEDOR: `falsa` en desarrollo
# y pruebas; en producción no hay pasarela (503) hasta configurar el proveedor real.
PASARELA_PROVEEDOR=
# Secreto HMAC de los webhooks de la pasarela falsa (solo laboratorio; hay uno por defecto)
PASARELA_FALSA_SECRETO=
# URL pública de la API para la página de pago simulada (url_pago de la pasarela falsa)
PASARELA_URL_PUBLICA=http://localhost:3333
# Orígenes (esquema://host[:puerto], separados por comas) a los que la pasarela puede devolver al
# cliente con url_retorno (p. ej. el portal). Otro origen → 422. Vacía: el origen de NOTIFY_PORTAL_URL;
# sin ninguna de las dos no se acepta url_retorno.
PASARELA_RETORNO_ORIGENES=http://localhost:3001
# Recurrente (PASARELA_PROVEEDOR=recurrente; https://docs.recurrente.com). Nunca en el repo.
# Llave secreta: sk_live_… (producción) o sk_test_… (Sandbox); la URL base es la misma.
RECURRENTE_SECRET_KEY=
# Secreto de firma del endpoint de webhooks (whsec_…), lo da Recurrente al registrar
# <API pública>/api/v1/pasarela/webhook/recurrente
RECURRENTE_WEBHOOK_SECRETO=
# Opcionales: URL base de la API y horas de vigencia del checkout
RECURRENTE_API_URL=
RECURRENTE_EXPIRA_HORAS=24

# Límite de POST /auth/login (app/core/auth/limite_login.ts): intentos por IP (todos) y fallidos por
# usuario dentro de la ventana; 0 apaga ese contador. Al pasarse: 429 con Retry-After.
LOGIN_LIMITE_IP=30
LOGIN_LIMITE_USUARIO=5
LOGIN_LIMITE_VENTANA_S=900
# Prefijo de las claves en Redis (vacío = <COLAS_PREFIJO>:login)
LOGIN_LIMITE_PREFIJO=
