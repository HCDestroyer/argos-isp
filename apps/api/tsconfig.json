{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./",
    "target": "ESNext",
    "outDir": "./build",
    "lib": ["ES2023"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "declaration": false,
    "sourceMap": true,
    "removeComments": true
  },
  "ts-node": {
    "swc": true
  },
  "exclude": ["node_modules", "build"]
}
