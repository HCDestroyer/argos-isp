# URL base de apps/api (sin /api/v1; las rutas del contrato ya lo incluyen).
NUXT_PUBLIC_API_BASE=http://localhost:3333

# true: useApi() responde desde apps/web/fixtures sin backend.
# Usuarios de prueba: admin@argos.test y cajero@argos.test (cualquier contraseña).
NUXT_PUBLIC_USE_FIXTURES=false

# Puerto del servidor Nitro en producción (node .output/server/index.mjs).
PORT=3000
