{
    "name": "argosisp",
    "private": true,
    "packageManager": "pnpm@10.28.0",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "lint": "pnpm -r --parallel --if-present lint",
        "typecheck": "pnpm -r --if-present typecheck",
        "test": "pnpm -r --if-present test",
        "build": "pnpm -r --if-present build",
        "format": "prettier --write .",
        "aaa:clients": "pnpm --filter @argosisp/aaa clients",
        "contracts:build": "pnpm --filter @argosisp/api openapi:generate && pnpm --filter @argosisp/contracts build",
        "verificar:permisos": "node scripts/verificar-permisos.mjs",
        "demo:datos": "node scripts/demo/datos.mjs",
        "importar": "pnpm --filter @argosisp/api importar",
        "importar:plantillas": "pnpm --filter @argosisp/api importar:plantillas",
        "emergencia:secrets-ppp": "pnpm --filter @argosisp/api exec node ace emergencia:secrets-ppp",
        "aaa:verificar-router": "pnpm --filter @argosisp/api exec node ace aaa:verificar-router",
        "aaa:carga": "AAA_CARGA=1 pnpm --filter @argosisp/api exec node ace test --files tests/network/carga_radius.spec.ts"
    },
    "devDependencies": {
        "prettier": "^3.6.2",
        "typescript": "~5.9.3"
    }
}
